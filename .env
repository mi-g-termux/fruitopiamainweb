# ============================================================
# FIREBASE CONFIGURATION
# Leave these EMPTY for first-run installation.
# On boot, the app will detect the missing config and redirect
# every route to the /InstallWizard onboarding view, where the
# end-user pastes their own Firebase keys. The Express server
# (POST /api/system/install — alias of /api/save-config) writes
# the submitted values to firebase-config.json on disk and the
# app hot-reloads using the freshly saved configuration.
#
# Only fill these in if you prefer baking the config into the
# build (Vercel/Netlify-style env-var deploys). For VPS / cPanel
# installs, keep them blank and use the wizard.
# ============================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# ============================================================
# APP URL (used for invoice links etc.)
# Set this to your live domain once deployed
# ============================================================
VITE_APP_URL=""
